node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Generated by scripts/generate-voiceover.mjs — regenerated on every render.
public/audio

# Local Task Scheduler run logs — machine-specific, not part of the repo.
scripts/daily-content-writer.log
scripts/reply-comments.log
scripts/comment-outreach.log
scripts/animated-episode-writer.log

# Local-only YouTube API credentials for the Task Scheduler-run scripts
# (scripts/run-reply-comments.ps1, run-comment-outreach.ps1) — loaded into
# the process environment before invoking claude, since Task Scheduler
# processes don't inherit any secrets set for a GitHub Actions job. Never
# commit this — same 4 values as the GitHub secrets of the same name.
scripts/.env.youtube.local

# Local-only GitHub PAT for scripts/check-and-catchup-publish.mjs (needs
# Actions:write to trigger workflow_dispatch as a safety net when
# GitHub's own cron schedule silently misses a publish tick). Never
# commit — same token as stored in Claude's persistent memory, scoped
# only to saintzzz/tokvideo.
scripts/.env.github.local
scripts/catchup-publish.log
scripts/animated-film-pipeline.log
blender/.render-lock.json
blender/ep*_full_render.log

# Rendered frames/video from the Blender proof-of-concept scripts under
# blender/ — regenerate by running the script, same convention as out/.
blender/out
